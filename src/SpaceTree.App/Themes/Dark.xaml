<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:Boolean x:Key="Theme.IsDark">True</sys:Boolean>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Brush.Window" Color="#1A1A1E" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#212127" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#26262D" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="#2C2C34" />
    <SolidColorBrush x:Key="Brush.Chrome" Color="#17171B" />

    <!-- Lines -->
    <SolidColorBrush x:Key="Brush.Border" Color="#33333C" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#45454F" />
    <SolidColorBrush x:Key="Brush.Separator" Color="#2E2E36" />

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.Text" Color="#EDEDF2" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#9C9CAB" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="#61616E" />
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="#FFFFFF" />

    <!-- Accent -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#4C8DFF" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#6BA1FF" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#3A78E0" />
    <SolidColorBrush x:Key="Brush.AccentMuted" Color="#2A3A5C" />

    <!-- Interaction -->
    <SolidColorBrush x:Key="Brush.Control" Color="#2B2B33" />
    <SolidColorBrush x:Key="Brush.ControlHover" Color="#35353F" />
    <SolidColorBrush x:Key="Brush.ControlPressed" Color="#3E3E4A" />
    <SolidColorBrush x:Key="Brush.RowHover" Color="#2A2A33" />
    <SolidColorBrush x:Key="Brush.RowSelected" Color="#33456B" />
    <SolidColorBrush x:Key="Brush.RowSelectedInactive" Color="#2C2C36" />

    <!-- Semantic -->
    <SolidColorBrush x:Key="Brush.Danger" Color="#E5484D" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#E5A23C" />
    <SolidColorBrush x:Key="Brush.Success" Color="#46A758" />

    <!-- Treemap / chart plate -->
    <SolidColorBrush x:Key="Brush.PlotBackground" Color="#16161A" />
    <SolidColorBrush x:Key="Brush.TileStroke" Color="#12121500" />

</ResourceDictionary>
