<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:Boolean x:Key="Theme.IsDark">False</sys:Boolean>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Brush.Window" Color="#F5F5F7" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#FAFAFB" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Chrome" Color="#EDEDF0" />

    <!-- Lines -->
    <SolidColorBrush x:Key="Brush.Border" Color="#DDDDE3" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#C2C2CC" />
    <SolidColorBrush x:Key="Brush.Separator" Color="#E6E6EB" />

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.Text" Color="#1B1B1F" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#5F5F6B" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="#A0A0AC" />
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="#FFFFFF" />

    <!-- Accent -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#0F6CBD" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#1A7ED1" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#0C5896" />
    <SolidColorBrush x:Key="Brush.AccentMuted" Color="#D3E5F7" />

    <!-- Interaction -->
    <SolidColorBrush x:Key="Brush.Control" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.ControlHover" Color="#F0F0F4" />
    <SolidColorBrush x:Key="Brush.ControlPressed" Color="#E4E4EA" />
    <SolidColorBrush x:Key="Brush.RowHover" Color="#F0F4FA" />
    <SolidColorBrush x:Key="Brush.RowSelected" Color="#CFE4F9" />
    <SolidColorBrush x:Key="Brush.RowSelectedInactive" Color="#E8E8EE" />

    <!-- Semantic -->
    <SolidColorBrush x:Key="Brush.Danger" Color="#C62A2F" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#B87503" />
    <SolidColorBrush x:Key="Brush.Success" Color="#2C7A3E" />

    <!-- Treemap / chart plate -->
    <SolidColorBrush x:Key="Brush.PlotBackground" Color="#ECECF0" />
    <SolidColorBrush x:Key="Brush.TileStroke" Color="#FFFFFF00" />

</ResourceDictionary>
