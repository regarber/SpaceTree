<Window x:Class="SpaceTree.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SpaceTree.App.Converters"
        xmlns:ctl="clr-namespace:SpaceTree.App.Controls"
        xmlns:vm="clr-namespace:SpaceTree.App.ViewModels"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="SpaceTree" Height="800" Width="1280" MinWidth="900" MinHeight="560"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        AllowDrop="True"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <conv:FractionToStarConverter x:Key="Star" />
        <conv:FractionToStarConverter x:Key="StarInverse" Invert="True" />
        <conv:BarBrushConverter x:Key="BarBrush" />
        <conv:LevelToIndentConverter x:Key="Indent" />
        <conv:EmptyStringToVisibilityConverter x:Key="TextVisible" />
        <conv:EmptyStringToVisibilityConverter x:Key="TextEmpty" Invert="True" />
        <conv:NullToVisibilityConverter x:Key="NullVisible" Invert="True" />
        <conv:InverseBooleanToVisibilityConverter x:Key="FalseVisible" />
        <conv:IndexToSliceBrushConverter x:Key="SliceBrush" />
        <conv:FractionToWidthConverter x:Key="DriveMeterWidth" MaxWidth="46" />
        <conv:FractionToWidthConverter x:Key="VolumeMeterWidth" MaxWidth="70" />
        <BooleanToVisibilityConverter x:Key="TrueVisible" />

        <!-- Rows need a double-click handler, which cannot be expressed in a setter. -->
        <Style x:Key="TreeRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource TreeListItem}">
            <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick" />
            <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="700" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFile}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Numeric cells are right-aligned so magnitudes line up column-wise. -->
        <Style x:Key="NumericCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <Style x:Key="ToolbarLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <!--
            Used by both the tree and the treemap. x:Shared="False" hands each
            owner its own instance: a ContextMenu takes its DataContext from the
            element it is attached to, so one shared object cannot serve two.
        -->
        <ContextMenu x:Key="ItemContextMenu" x:Shared="False">
            <MenuItem Header="_Open" Command="{Binding OpenCommand}" InputGestureText="Ctrl+Enter" />
            <MenuItem Header="Show in _Explorer" Command="{Binding ShowInExplorerCommand}" />
            <Separator Style="{StaticResource Menu.Separator}" />
            <MenuItem Header="_Copy path" Command="{Binding CopyPathCommand}" InputGestureText="Ctrl+C" />
            <MenuItem Header="Zoom _into treemap" Command="{Binding ZoomInCommand}" />
            <Separator Style="{StaticResource Menu.Separator}" />
            <MenuItem Header="_Delete…" Command="{Binding DeleteCommand}" InputGestureText="Del"
                      Foreground="{DynamicResource Brush.Danger}" />
            <Separator Style="{StaticResource Menu.Separator}" />
            <MenuItem Header="P_roperties" Command="{Binding PropertiesCommand}" InputGestureText="Alt+Enter" />
        </ContextMenu>
    </Window.Resources>

    <!--
        Delete and Ctrl+C are deliberately absent here: a window-level KeyBinding
        fires even while a text box has focus, which would make the path and
        filter boxes uneditable. Those two are handled on the tree instead.
    -->
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding BrowseCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportCsvCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintCommand}" />
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="Enter" Modifiers="Alt" Command="{Binding PropertiesCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════ Command bar ═══════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Chrome}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="12,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <Path Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center"
                          Fill="{DynamicResource Brush.Accent}"
                          Data="M3,3 H9 L11,5 H21 V19 H3 Z M5,9 H19 V17 H5 Z" />
                    <TextBlock Text="SpaceTree" Margin="8,0,0,0" VerticalAlignment="Center"
                               FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                </StackPanel>

                <Grid Grid.Column="1" Width="176" Margin="0,0,8,0">
                <ComboBox x:Name="DriveBox"
                          ItemsSource="{Binding Drives}"
                          SelectedValuePath="Name"
                          ToolTip="Pick a drive to scan"
                          SelectionChanged="OnDriveSelected">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="200">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="1" Width="46" Height="5" CornerRadius="3" VerticalAlignment="Center"
                                        Background="{DynamicResource Brush.Separator}">
                                    <Rectangle HorizontalAlignment="Left" RadiusX="3" RadiusY="3"
                                               Fill="{DynamicResource Brush.Accent}"
                                               Width="{Binding UsedFraction, Converter={StaticResource DriveMeterWidth}}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                    <TextBlock Text="Drives…" Margin="10,0,0,0" IsHitTestVisible="False"
                               VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextDisabled}"
                               Visibility="{Binding SelectedItem, ElementName=DriveBox,
                                                    Converter={StaticResource NullVisible}}" />
                </Grid>

                <TextBox Grid.Column="2" Margin="0,0,8,0" x:Name="PathBox"
                         Text="{Binding SelectedPath, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Folder or drive to scan — you can also drop a folder onto the window"
                         KeyDown="OnPathBoxKeyDown" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,8,0">
                    <Button Style="{StaticResource Button.Subtle}" Content="▾" FontSize="13" Padding="8,3"
                            Click="OnRecentPathsClick" ToolTip="Recently scanned locations" />
                    <Button Content="Browse…" Command="{Binding BrowseCommand}" />

                </StackPanel>

                <Button Grid.Column="4" Content="Scan" Width="86" Margin="0,0,8,0"
                        Style="{StaticResource Button.Accent}"
                        Command="{Binding ScanCommand}"
                        Visibility="{Binding IsScanning, Converter={StaticResource FalseVisible}}" />

                <Button Grid.Column="4" Content="Cancel" Width="86" Margin="0,0,8,0"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding IsScanning, Converter={StaticResource TrueVisible}}" />

                <Button Grid.Column="5" Content="Refresh" Margin="0,0,8,0"
                        ToolTip="Rescan the current root (F5)"
                        Command="{Binding RefreshCommand}" />

                <StackPanel Grid.Column="6" Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Subtle}" Content="Export ▾" Click="OnExportMenuClick"
                            ToolTip="Export or print the current view">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Export to _CSV…" Command="{Binding ExportCsvCommand}" InputGestureText="Ctrl+E" />
                                <MenuItem Header="Export to _text…" Command="{Binding ExportTextCommand}" />
                                <MenuItem Header="Export _HTML report…" Command="{Binding ExportHtmlCommand}" />
                                <Separator Style="{StaticResource Menu.Separator}" />
                                <MenuItem Header="_Print / save as PDF…" Command="{Binding PrintCommand}" InputGestureText="Ctrl+P" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button Style="{StaticResource Button.Subtle}" Content="⚙" FontSize="14" Click="OnSettingsMenuClick"
                            ToolTip="Options">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Theme">
                                    <MenuItem Header="Follow _Windows" Click="OnThemeSystem" IsCheckable="True" x:Name="ThemeSystemItem" />
                                    <MenuItem Header="_Dark" Click="OnThemeDark" IsCheckable="True" x:Name="ThemeDarkItem" />
                                    <MenuItem Header="_Light" Click="OnThemeLight" IsCheckable="True" x:Name="ThemeLightItem" />
                                </MenuItem>
                                <MenuItem Header="Units">
                                    <MenuItem Header="Binary (KB = 1024 bytes)" IsCheckable="True"
                                              IsChecked="{Binding UseBinaryUnits, Mode=TwoWay}" />
                                </MenuItem>
                                <MenuItem Header="Scan threads" x:Name="ThreadMenu" />
                                <MenuItem Header="Follow junctions and symlinks" IsCheckable="True"
                                          IsChecked="{Binding FollowReparsePoints, Mode=TwoWay}"
                                          ToolTip="Off by default: reparse points double-count content and can form cycles" />
                                <Separator Style="{StaticResource Menu.Separator}" />
                                <MenuItem Header="Columns" x:Name="ColumnsMenu" />
                                <Separator Style="{StaticResource Menu.Separator}" />
                                <MenuItem Header="Restart as _administrator…" Command="{Binding RestartElevatedCommand}" />
                                <MenuItem Header="_About SpaceTree" Click="OnAbout" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════ Filter bar ═══════════════ -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Filter" Style="{StaticResource ToolbarLabel}" />

                <Grid Grid.Column="1" Margin="0,0,8,0">
                    <TextBox x:Name="FilterBox"
                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=220}"
                             ToolTip="Wildcards such as *.iso or log;tmp — Ctrl+F to focus, Esc to clear" />
                    <TextBlock Text="Name or *.ext…" Margin="9,0,0,0" IsHitTestVisible="False"
                               VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextDisabled}"
                               Visibility="{Binding FilterText, Converter={StaticResource TextEmpty}}" />
                    <Border Background="{DynamicResource Brush.Danger}" Height="2" VerticalAlignment="Bottom"
                            Margin="1,0,1,1" CornerRadius="1"
                            Visibility="{Binding HasInvalidFilterPattern, Converter={StaticResource TrueVisible}}"
                            ToolTip="That pattern is not a valid regular expression" />
                </Grid>

                <CheckBox Grid.Column="2" Content=".*" Margin="0,0,14,0"
                          IsChecked="{Binding UseRegexFilter, Mode=TwoWay}"
                          ToolTip="Treat the filter as a regular expression" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,14,0">
                    <TextBlock Text="Min size" Style="{StaticResource ToolbarLabel}" />
                    <TextBox Width="58" Text="{Binding MinimumSizeMb, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}"
                             ToolTip="Hide anything smaller than this many MB" />
                    <TextBlock Text="MB" Style="{StaticResource ToolbarLabel}" Margin="5,0,0,0" />
                </StackPanel>

                <CheckBox Grid.Column="4" Content="Hide empty" Margin="0,0,14,0"
                          IsChecked="{Binding HideEmptyFolders, Mode=TwoWay}"
                          ToolTip="Hide folders that contain no data" />

                <CheckBox Grid.Column="5" Content="Show files" Margin="0,0,14,0"
                          IsChecked="{Binding ShowFiles, Mode=TwoWay}"
                          ToolTip="List individual files inside folders" />

                <StackPanel Grid.Column="7" Orientation="Horizontal">
                    <CheckBox Content="Size bars" Margin="0,0,12,0"
                              IsChecked="{Binding ShowSizeBars, Mode=TwoWay}" />
                    <Button Style="{StaticResource Button.Subtle}" Content="Expand branch"
                            Command="{Binding ExpandBranchCommand}"
                            ToolTip="Open the selected branch a few levels down" />
                    <Button Style="{StaticResource Button.Subtle}" Content="Collapse all"
                            Command="{Binding CollapseAllCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════ Scan progress ═══════════════ -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="12,7"
                Visibility="{Binding IsScanning, Converter={StaticResource TrueVisible}}">
            <StackPanel>
                <Grid Margin="0,0,0,5">
                    <TextBlock Text="{Binding ProgressPrimary}" FontSize="11.5"
                               Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock Text="{Binding ProgressEta}" HorizontalAlignment="Right"
                               Style="{StaticResource StatusText}" />
                </Grid>
                <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Margin="0,0,0,5" />
                <Grid>
                    <TextBlock Text="{Binding ProgressCurrentPath}" Style="{StaticResource StatusText}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ProgressRate}" HorizontalAlignment="Right"
                               Style="{StaticResource StatusText}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ═══════════════ Main content ═══════════════ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" x:Name="TreeColumn" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="440" MinWidth="240" x:Name="VisualColumn" />
            </Grid.ColumnDefinitions>

            <!-- Tree -->
            <ListView Grid.Column="0" x:Name="Tree"
                      Style="{StaticResource TreeList}"
                      ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      ItemContainerStyle="{StaticResource TreeRowStyle}"
                      ContextMenu="{StaticResource ItemContextMenu}"
                      PreviewKeyDown="OnTreeKeyDown">
                <ListView.View>
                    <GridView AllowsColumnReorder="True" x:Name="Columns">

                        <GridViewColumn Header="Name" Width="300">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="{Binding Level, Converter={StaticResource Indent}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Expander chevron -->
                                        <Button Grid.Column="0" Width="16" Height="16" Padding="0"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                Command="{Binding DataContext.ToggleExpandCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsExpandable, Converter={StaticResource TrueVisible}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent">
                                                        <Path x:Name="Chevron" Width="7" Height="7" Stretch="Uniform"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Data="M 0,0 L 5,5 L 0,10"
                                                              Stroke="{DynamicResource Brush.TextSecondary}"
                                                              StrokeThickness="1.5"
                                                              StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                                              RenderTransformOrigin="0.5,0.5" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <!-- A trigger can only target a named FrameworkElement, so the
                                                             transform is replaced wholesale rather than animated in place. -->
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter TargetName="Chevron" Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <RotateTransform Angle="90" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Chevron" Property="Stroke"
                                                                    Value="{DynamicResource Brush.Text}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <TextBlock Grid.Column="1" Text="{Binding Glyph}" VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                                   Foreground="{DynamicResource Brush.Accent}" />

                                        <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="2,0,8,0" />
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Size" Width="122">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <!-- The bar is the cell background, so the number stays readable on top. -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding BarFraction, Converter={StaticResource Star}}" />
                                                <ColumnDefinition Width="{Binding BarFraction, Converter={StaticResource StarInverse}}" />
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Grid.Column="0" RadiusX="2" RadiusY="2" Margin="0,2"
                                                       Fill="{Binding BarFraction, Converter={StaticResource BarBrush}}" />
                                        </Grid>
                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource NumericCell}" />
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Allocated" Width="96">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding AllocatedText}" Style="{StaticResource NumericCell}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="% of Parent" Width="86">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PercentText}" Style="{StaticResource NumericCell}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Files" Width="72">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FilesText}" Style="{StaticResource NumericCell}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Folders" Width="72">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FoldersText}" Style="{StaticResource NumericCell}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Last Modified" Width="118">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ModifiedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                    </GridView>
                </ListView.View>
            </ListView>

            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

            <!-- Visualisation -->
            <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}">
                    <TabControl x:Name="VisualTabs" SelectionChanged="OnVisualTabChanged">
                        <TabItem Header="Treemap">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Padding="10,7" Background="{DynamicResource Brush.SurfaceAlt}"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding TreemapRootPath}"
                                                   Style="{StaticResource StatusText}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Style="{StaticResource Button.Subtle}" Content="Up"
                                                    Command="{Binding ZoomOutCommand}" ToolTip="Zoom out one level" />
                                            <Button Style="{StaticResource Button.Subtle}" Content="Reset"
                                                    Command="{Binding ZoomResetCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <ctl:TreemapControl Grid.Row="1" x:Name="Treemap"
                                                    RootNode="{Binding TreemapRoot}"
                                                    Units="{Binding Context.Units}"
                                                    ContextMenu="{StaticResource ItemContextMenu}" />
                            </Grid>
                        </TabItem>

                        <TabItem Header="Chart">
                            <Grid Margin="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" MinHeight="150" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ctl:ShareChartControl Grid.Row="0" x:Name="Chart" Margin="12"
                                                       ItemsSource="{Binding ChartSlices}"
                                                       Units="{Binding Context.Units}"
                                                       TotalText="{Binding TreemapRootSizeText}" />

                                <ScrollViewer Grid.Row="1" MaxHeight="230" VerticalScrollBarVisibility="Auto"
                                              Padding="12,0,12,12">
                                    <ItemsControl ItemsSource="{Binding ChartSlices}" AlternationCount="10">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle Grid.Column="0" Width="10" Height="10" RadiusX="2" RadiusY="2"
                                                               VerticalAlignment="Center" Margin="0,0,8,0"
                                                               Fill="{Binding (ItemsControl.AlternationIndex),
                                                                              RelativeSource={RelativeSource AncestorType=ContentPresenter},
                                                                              Converter={StaticResource SliceBrush}}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                                                               Style="{StaticResource StatusText}"
                                                               Text="{Binding Fraction, StringFormat={}{0:P1}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                    </TabControl>
            </Border>
        </Grid>

        <!-- ═══════════════ Status bar ═══════════════ -->
        <Border Grid.Row="4" Background="{DynamicResource Brush.Chrome}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusTotal}" Margin="0,0,16,0"
                           VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text}" FontSize="11.5" />

                <TextBlock Grid.Column="1" Text="{Binding StatusItems}" Margin="0,0,16,0"
                           Style="{StaticResource StatusText}" />

                <TextBlock Grid.Column="2" Text="{Binding SelectionSummary}" Margin="0,0,16,0"
                           Style="{StaticResource StatusText}" TextTrimming="CharacterEllipsis" />

                <Border Grid.Column="3" Margin="0,0,16,0" Padding="7,2" CornerRadius="3"
                        Background="{DynamicResource Brush.Warning}"
                        Visibility="{Binding IsStale, Converter={StaticResource TrueVisible}}"
                        ToolTip="Items were deleted since this scan — press F5 to rescan">
                    <TextBlock Text="Out of date" Foreground="#1B1B1F" FontSize="11" FontWeight="SemiBold" />
                </Border>

                <Button Grid.Column="4" Style="{StaticResource Button.Subtle}" Margin="0,0,12,0" Padding="6,2"
                        MinHeight="0" Command="{Binding ShowErrorsCommand}"
                        Visibility="{Binding HasErrors, Converter={StaticResource TrueVisible}}"
                        ToolTip="Show folders that could not be read">
                    <TextBlock Text="{Binding StatusErrors}" FontSize="11.5"
                               Foreground="{DynamicResource Brush.Warning}" />
                </Button>

                <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="0,0,16,0"
                            Visibility="{Binding StatusVolume, Converter={StaticResource TextVisible}}">
                    <Border Width="70" Height="6" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,8,0"
                            Background="{DynamicResource Brush.Separator}">
                        <Rectangle HorizontalAlignment="Left" RadiusX="3" RadiusY="3"
                                   Fill="{DynamicResource Brush.Accent}"
                                   Width="{Binding VolumeUsedFraction, Converter={StaticResource VolumeMeterWidth}}" />
                    </Border>
                    <TextBlock Text="{Binding StatusVolume}" Style="{StaticResource StatusText}" />
                </StackPanel>

                <TextBlock Grid.Column="6" Text="{Binding StatusScanTime}" Style="{StaticResource StatusText}" />
            </Grid>
        </Border>
    </Grid>
</Window>
