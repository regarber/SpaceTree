<Window x:Class="SpaceTree.App.Views.DeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete" SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Path Width="24" Height="24" Stretch="Uniform" VerticalAlignment="Top"
                  Fill="{DynamicResource Brush.Danger}"
                  Data="M6,7 H18 L17,20 H7 Z M9,4 H15 V6 H9 Z M4,6 H20 V7 H4 Z" />
            <TextBlock x:Name="Headline" Margin="12,0,0,0" VerticalAlignment="Center"
                       FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Text}" />
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                CornerRadius="4" Padding="12,9" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="PathText" TextWrapping="Wrap" FontFamily="Consolas, Courier New"
                           Foreground="{DynamicResource Brush.Text}" />
                <TextBlock x:Name="DetailText" Margin="0,7,0,0"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,0,0,6">
            <RadioButton x:Name="RecycleOption" GroupName="Mode" IsChecked="True" Margin="0,0,0,7"
                         Foreground="{DynamicResource Brush.Text}">
                <TextBlock Text="Move to the Recycle Bin" />
            </RadioButton>
            <RadioButton x:Name="PermanentOption" GroupName="Mode"
                         Foreground="{DynamicResource Brush.Text}">
                <TextBlock Text="Delete permanently (cannot be undone)" />
            </RadioButton>
        </StackPanel>

        <TextBlock Grid.Row="3" Margin="0,8,0,16" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.TextSecondary}"
                   Text="The scan on screen will not match the disk afterwards — press F5 to rescan." />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="92" Margin="0,0,8,0" IsCancel="True" Click="OnCancel" />
            <Button x:Name="ConfirmButton" Content="Delete" Width="92" IsDefault="True" Click="OnConfirm"
                    Style="{StaticResource Button.Accent}"
                    Background="{DynamicResource Brush.Danger}"
                    BorderBrush="{DynamicResource Brush.Danger}" />
        </StackPanel>
    </Grid>
</Window>
