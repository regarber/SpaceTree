<Window x:Class="SpaceTree.App.Views.ErrorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folders that could not be read" Height="480" Width="820"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="Summary" Margin="0,0,0,12" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.TextSecondary}" />

        <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="4">
            <ListView x:Name="ErrorList" Style="{StaticResource TreeList}" Margin="1">
                <ListView.View>
                    <GridView AllowsColumnReorder="False">
                        <GridViewColumn Header="Path" Width="560">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Path}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="4,0" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Reason" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Message}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="4,0" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Copy all" Width="98" Margin="0,0,8,0" Click="OnCopyAll" />
            <Button Content="Close" Width="98" IsCancel="True" IsDefault="True" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
